# ─────────────────────────────────────────────────────────────────────────────
# Backend .gitignore — Multi-Model Chatbot MVP
# Project type: NestJS + TypeORM + Node.js 20 (PostgreSQL)
# ─────────────────────────────────────────────────────────────────────────────

# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
jspm_packages/

# ── Build output ────────────────────────────────────────────────────────────
# NestJS / TypeScript build artifacts
dist/
build/
out/
*.tsbuildinfo

# tsc incremental cache
*.tsbuildinfo
.tsbuildinfo

# ── Runtime data & secrets ──────────────────────────────────────────────────
# Environment files (NEVER commit secrets)
.env
.env.*
!.env.example

# Local config overrides
*.local

# Postgres local data dir (if someone runs it on-host during dev)
pgdata/

# ── Logs ────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Testing & coverage ──────────────────────────────────────────────────────
coverage/
.nyc_output/
*.lcov
.jest-cache/

# ── IDE & OS ────────────────────────────────────────────────────────────────
# JetBrains / IntelliJ
.idea/
*.iml
*.iws
*.ipr

# VS Code
.vscode/
!.vscode/extensions.json
!.vscode/settings.example.json

# Cursor
.cursor/

# OS
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# Windows-specific
$RECYCLE.BIN/
System Volume Information/

# ── NestJS / framework specific ─────────────────────────────────────────────
# The OpenAPI export script (`npm run openapi:export`) writes directly to
# the source-of-truth artifact at
# `specs/001-multi-model-chatbot-mvp/contracts/openapi-3.1.yaml`, which is
# committed. There is no longer a separate generated file to ignore.

# ── Tooling caches ──────────────────────────────────────────────────────────
.eslintcache
.stylelintcache
.parcel-cache/
.cache/
.webpack-cache/
.turbo/
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# ── Misc / safety net ───────────────────────────────────────────────────────
# Lockfiles generated by alternate package managers (we standardize on npm)
yarn.lock
pnpm-lock.yaml
bun.lockb

# Temporary files
*.tmp
*.bak
*.swp
*~

# Secret material that should never appear in repo even by accident
*.pem
*.key
*.crt
secrets/

# AI Agent Specific Ignores
skills-lock.json
.claude

.kilo
.specify