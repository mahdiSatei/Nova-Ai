# ─────────────────────────────────────────────────────────────────────────────
# Chatbot Backend — Example environment file
# Copy to .env and fill in real values for local development.
# .env is gitignored; this file is committed as the contract between
# the repo and the operator.
# ─────────────────────────────────────────────────────────────────────────────

# Server
PORT=3000
NODE_ENV=development

# JWT (HS256). Generate with: openssl rand -hex 32
JWT_SECRET=replace-me-with-32-bytes-of-randomness-please-do-not-use-this-in-anywhere-real
JWT_REFRESH_SECRET=replace-me-with-32-bytes-of-randomness-please-do-not-use-this-in-anywhere-real
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Database (PostgreSQL).
# You can either set POSTGRES_URL directly, or fill in the individual fields below.
# POSTGRES_URL=postgres://user:password@localhost:5432/chatbot_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=novadb

# Structured logs (pino-roll)
LOG_LEVEL=info
LOG_DIR=./logs

# Provider credential encryption. 32 random bytes, base64-encoded.
# Generate with: openssl rand -base64 32
PROVIDER_ENCRYPTION_KEY=replace-me-with-base64-32-bytes-==

# Object storage (MinIO, S3-compatible). Matches the minio service in docker-compose.yaml.
STORAGE_ENDPOINT=localhost
STORAGE_PORT=9000
STORAGE_USE_SSL=false
STORAGE_ACCESS_KEY=admin
STORAGE_SECRET_KEY=12345678
STORAGE_BUCKET=chat-files
STORAGE_PRESIGN_EXPIRY_SEC=604800

# Admin seed (used by scripts/seed-admin.ts)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-me-with-a-long-admin-password

# Web Search (Phase 7) — backend-only credential. Leave unset to disable web search.
# The key is never sent to the frontend.
SERPEX_API_KEY=sk_your_serpex_key
SERPEX_API_URL=https://api.serpex.dev

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Billing (Phase 5) — Toman prices. Deployment-level configuration: read-only in
# the Admin UI and NEVER editable through the API.
# CREDIT_PRICE_TOMAN is the Toman price of one Credit; model prices are stored
# per-model as Toman per 1M tokens and converted with this rate.
CREDIT_PRICE_TOMAN=100
WEB_SEARCH_PRICE_TOMAN=1000

# Credit purchase (Phase 2, Zibal) — all optional.
# Leave ZIBAL_MERCHANT and ZIBAL_CALLBACK_URL empty to keep credit purchases
# disabled: the app boots, and POST /v1/credit-purchases fails with
# `payment_not_configured` instead of selling credits it cannot collect for.
#
# Credits are sold at CREDIT_PRICE_TOMAN (above), the same rate that converts
# usage cost into Credits, so buying and spending can never disagree.
#
# Where the browser is sent once our callback has finished handling the payment.
PAYMENT_RESULT_REDIRECT_URL=http://localhost:5173/chat/payment-result
# Zibal merchant code. `zibal` is the sandbox merchant.
ZIBAL_MERCHANT=zibal
# Zibal API base. Point this at http://127.0.0.1:3010 to use the bundled fake
# (start it with `npm run start:fake-zibal`).
ZIBAL_BASE_URL=https://gateway.zibal.ir
# Public URL of THIS API's callback endpoint; the browser must be able to reach it.
ZIBAL_CALLBACK_URL=http://localhost:3000/v1/payments/zibal/callback
# HTTP timeout for Zibal request/verify calls, in milliseconds (min 1000).
ZIBAL_TIMEOUT_MS=10000

# Fake Zibal server (dev/test only) — `npm run start:fake-zibal`.
FAKE_ZIBAL_PORT=3010